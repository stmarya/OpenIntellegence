ENVIRONMENT=development
DEBUG=true
API_BASE_URL=http://localhost:8000/api/v1
DATABASE_URL=postgresql+asyncpg://openintel:openintel@localhost:5432/openintel
REDIS_URL=redis://localhost:6379/0
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
DEFAULT_RATE_LIMIT_PER_HOUR=1000
AGENT_CA_CERT_PATH=./certs/agent-ca.crt
AGENT_CA_KEY_PATH=./certs/agent-ca.key
AGENT_CA_KEY_PASSWORD=
AGENT_CERT_TTL_DAYS=90
AGENT_HEARTBEAT_INTERVAL_SECONDS=60
AGENT_STALE_AFTER_MISSED=5
RANSOMWARE_LIVE_API_KEY=
GITHUB_TOKEN=
NVD_API_KEY=
OTX_API_KEY=
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_TOKEN=
CONNECTOR_DELIVERY_TIMEOUT_SECONDS=10
CONNECTOR_MAX_ATTEMPTS=5
CONNECTOR_POLL_INTERVAL_SECONDS=5
ALERT_EVALUATION_INTERVAL_SECONDS=30
INTENT_EXPIRY_INTERVAL_SECONDS=60
INTERNAL_AUTOMATION_INTERVAL_SECONDS=5
COMMAND_SIGNING_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=12
LLM_TIMEOUT_SECONDS=120
# Server-side service key for SSR and allowlisted write forwarding.
API_SERVICE_KEY=
# Separate operator secret required for write actions; never reuse an API key.
CONSOLE_ACTION_TOKEN=
CORS_ORIGINS=["http://localhost:3000","https://app.nogosec.id"]
