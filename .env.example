# OpenIntelligence backend configuration.
#
# Copy to .env and fill in. Never commit the real .env — the previous
# collector scripts hardcoded a Ransomware.live PRO key directly in source,
# which is why every credential now lives here instead.

ENVIRONMENT=development
DEBUG=true
API_BASE_URL=https://api.nogosec.id

# --- Datastores -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://openintel:openintel@localhost:5432/openintel
REDIS_URL=redis://localhost:6379/0

# --- API keys ---------------------------------------------------------------
# Argon2id parameters. Raising memory cost is the single most effective
# defence against offline cracking if the hash table is ever stolen.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
DEFAULT_RATE_LIMIT_PER_HOUR=1000

# --- Endpoint agent mTLS ----------------------------------------------------
# Generate a development CA with:
#   python -m app.agent_gateway.bootstrap_ca --out ./certs
# In production the CA private key belongs in an HSM or KMS, not on disk.
AGENT_CA_CERT_PATH=./certs/agent-ca.crt
AGENT_CA_KEY_PATH=./certs/agent-ca.key
AGENT_CA_KEY_PASSWORD=
AGENT_CERT_TTL_DAYS=90
AGENT_HEARTBEAT_INTERVAL_SECONDS=60
AGENT_STALE_AFTER_MISSED=5

# --- Feed credentials -------------------------------------------------------
# Each is optional. A missing key disables that connector cleanly; it does
# not crash the ingest run, and the feed is reported as unconfigured rather
# than silently contributing zero records.
RANSOMWARE_LIVE_API_KEY=
GITHUB_TOKEN=
NVD_API_KEY=
OTX_API_KEY=

# --- AI layer ---------------------------------------------------------------
# Point LLM_BASE_URL at a self-hosted gateway to keep intelligence data off a
# third-party provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=12

# --- HTTP -------------------------------------------------------------------
# Explicit allowlist. A wildcard combined with credentialed requests would
# let any origin read a tenant's intelligence.
CORS_ORIGINS=["http://localhost:3000","https://app.nogosec.id"]
