# Absolute backend origin used only by Next.js server rendering and route handlers.
API_BASE_URL=http://localhost:8000/api/v1

# Server-only service credential for the action workbench. Never prefix this
# variable with NEXT_PUBLIC_ and never expose it to browser code.
API_SERVICE_KEY=

# Optional public base for deployments that intentionally expose read APIs.
NEXT_PUBLIC_API_BASE_URL=
