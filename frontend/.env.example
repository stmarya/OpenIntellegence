# OpenIntellegence Frontend — local development
# Copy to .env.local and fill in values for live backend integration

# Backend API base URL (leave empty to use mock data)
NEXT_PUBLIC_API_BASE_URL=

# Environment label shown in the top bar
NEXT_PUBLIC_ENV_LABEL=development

# Tenant name shown in the top bar
NEXT_PUBLIC_TENANT_NAME=Demo Tenant

# API key for backend requests (server-side only, not exposed to browser)
API_KEY=
